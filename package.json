{
  "name": "next16-team-chat",
  "version": "0.1.0",
  "private": true,
  "description": "A Next.js 16 team chat app demonstrating Cache Components, Partial Prefetching, and Instant Navigations with React Query.",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "nextjs-16",
    "cache-components",
    "partial-prefetching",
    "instant-navigation",
    "react-query",
    "team-chat",
    "messaging"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aurorascharff/next16-team-chat.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "prettier --write .",
    "prisma.push": "prisma db push",
    "prisma.seed": "prisma db seed",
    "prisma.studio": "prisma studio",
    "prisma.reset": "prisma db push --force-reset && pnpm prisma.seed",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.35",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.27.0",
    "next": "^16.3.0-preview.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.34.3"
}
