generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  handle    String   @unique
  name      String
  role      String
  createdAt DateTime @default(now())

  messages    Message[]
  memberships ChannelMember[]
  groups      ChannelGroup[]
  reactions   Reaction[]
}

model Channel {
  id          String   @id
  name        String
  description String
  category    String   @default("Channels")
  isPrivate   Boolean  @default(false)
  unread      Int      @default(0)
  status      String
  handoff     String
  createdAt   DateTime @default(now())

  messages Message[]
  members  ChannelMember[]
  pinned   PinnedItem[]
}

// A user-owned, editable grouping of channels in their sidebar (e.g. NOW, DAILY).
model ChannelGroup {
  id       String @id
  userId   String
  name     String
  position Int

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  members ChannelMember[]

  @@unique([userId, name])
  @@index([userId, position])
}

model ChannelMember {
  channelId String
  userId    String
  groupId   String?
  position  Int     @default(0)

  channel Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   ChannelGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@id([channelId, userId])
  @@index([userId])
  @@index([groupId, position])
}

model Message {
  id        String   @id
  body      String
  createdAt DateTime

  channelId String
  userId    String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  parentId  String?
  parent    Message?   @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[]  @relation("MessageReplies")
  reactions Reaction[]

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@index([userId])
}

model Reaction {
  emoji     String
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
}

model PinnedItem {
  id        String  @id
  label     String
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}
